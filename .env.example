# ---------------------------------------------------------------------------
# Sistema de Gestión de Cobranzas — Archivo de entorno de referencia
# Copia a ".env" y ajusta. Las variables marcadas como obligatorias deben
# tener un valor propio en cualquier entorno que no sea desarrollo local.
# Nunca se debe subir ".env" al repositorio (ver .gitignore).
# ---------------------------------------------------------------------------

# --- PostgreSQL (se usa en docker-compose.yml, servicio "db") --------------
POSTGRES_USER=cobranzas
POSTGRES_PASSWORD=cambiar-en-produccion
POSTGRES_DB=cobranzas

# --- Backend ---------------------------------------------------------------
# Cadena de conexión SQLAlchemy (driver psycopg3). Debe coincidir con las
# credenciales de arriba. El host "db" es el nombre del servicio en la red
# interna de Docker Compose; si el backend corre fuera de Compose, usa el
# host/IP real de la base.
DATABASE_URL=postgresql+psycopg://cobranzas:cambiar-en-produccion@db:5432/cobranzas

# Clave de firma de JWT. OBLIGATORIA en producción: genera una aleatoria, p. ej.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# No reutilizar la que viene por defecto en app/config.py.
SECRET_KEY=reemplazar-por-una-clave-aleatoria-larga

# Expiración del token en minutos (default 480 = 8 h).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Directorio de archivos dentro del contenedor (persistido en uploads_data;
# actualmente reservado: la carga por operador no guarda archivos).
UPLOAD_DIR=/data/uploads

# Puerto interno de uvicorn (default 8000). En plataformas que inyectan
# "PORT" (Render), esa variable tiene prioridad.
BACKEND_PORT=8000

# --- Frontend --------------------------------------------------------------
# Puerto del frontend expuesto en el host (mapea al :80 del contenedor).
FRONTEND_PORT=8080

# Reservado: actualmente el cliente fija el prefijo "/api" en el código
# (frontend/src/api/client.ts); esta variable no se consume todavía.
# VITE_API_BASE=/api